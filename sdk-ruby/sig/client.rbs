# The client and its `emails` resource.
module Unsent
  # The Unsent client. Thread-safe: create one and share it.
  #
  #   client = Unsent::Client.new(base_url: 'https://unsent.example.com', api_key: '...', api_secret: '...')
  #   client.send_email(to: 'user@example.com', subject: 'Hi', html: '<p>Hello</p>')
  #
  # With no options it reads UNSENT_BASE_URL, UNSENT_API_KEY and UNSENT_API_SECRET from the environment.
  class Client
    # The options `Unsent::Client.new` accepts (as keyword arguments or as one Hash).
    OPTION_KEYS: Array[Symbol]

    # Send and inspect emails.
    attr_reader emails: Emails

    # @raise [ConfigError] when an option (or a credential) is invalid
    def initialize: (*untyped args, **untyped kwargs) -> void

    # Builds a client from an environment-like Hash (or from ENV). `env:` and the credential variables are read
    # from +env+; +overrides+ are the same options as {#initialize}.
    def self.from_env: (?untyped env, **untyped overrides) -> Client

    def send_email: (*untyped args, **untyped kwargs) -> SendResult
    alias deliver send_email

    # Queue counters. Also a cheap way to verify that your credentials are accepted.
    def status: (*untyped args, **untyped kwargs) -> QueueStatus

    # Public liveness probe. Needs no credentials, so it does not verify them; use {#status} for that.
    def health: (*untyped args, **untyped kwargs) -> Health

    # The normalized base URL.
    def base_url: () -> String

    def inspect: () -> String
    alias to_s inspect

    def pretty_print: (untyped pp) -> untyped

    def to_json: (*untyped args) -> String
    def as_json: (*untyped args) -> Hash[Symbol, untyped]

    def marshal_dump: () -> bot
  end

  # `client.emails`: send and inspect emails. Thread-safe.
  class Emails
    # Valid per-call transport overrides: timeout, max_retries, cancel.
    REQUEST_KEYS: Array[Symbol]

    # Options accepted by {#send_email}.
    SEND_KEYS: Array[Symbol]

    # Options accepted by {#list}.
    LIST_KEYS: Array[Symbol]

    # Options accepted by {#each}.
    EACH_KEYS: Array[Symbol]

    # Options accepted by {#wait}.
    WAIT_KEYS: Array[Symbol]

    # Queues an email for delivery (HTTP 202) and returns as soon as the service has accepted it. Use {#wait}
    # to block until it is actually sent. Everything is validated before any network I/O.
    #
    # @param from "Name <a@b.co>", "a@b.co" or { email:, name: }; falls back to the client's default_from
    # @param to up to 100 recipients
    # @param subject required, up to 1000 characters
    # @param html provide html, text, or both; a text-only send gets an HTML body derived from it
    # @param attachments up to 20, see {Attachment}
    # @param provider_id force a specific provider; falls back to the client's default_provider_id
    # @param idempotency_key your own key, or +false+ to disable (then the send is never retried)
    # @raise [ValidationError] nothing was sent
    def send_email: (*untyped args, **untyped kwargs) -> SendResult
    alias deliver send_email

    # Fetches one email, including attachment contents.
    # @raise [NotFoundError] if it does not exist
    def get: (Integer id, **untyped request_options) -> EmailDetail

    # Lists emails, most recently updated first by default. Attachment contents are not included.
    #
    # @param limit 1..200
    # @param status queued | sending | sent | failed
    # @param from created on/after this day (UTC)
    # @param to created on/before this day (UTC)
    # @param sort one of SORT_ORDERS
    def list: (**untyped options) -> ListResult

    # Iterates over every matching email, fetching pages as needed. Oldest first by default. Without a block it
    # returns a lazy Enumerator.
    def each: (**untyped options) -> Enumerator[Email, void]
            | (**untyped options) { (Email) -> void } -> void
    alias iterate each

    # Polls until the email is delivered ("sent") or has permanently failed, then returns it.
    #
    # @param timeout give up after this many seconds with TimeoutError (default 60)
    # @param interval first poll interval in seconds; grows by 1.5x up to 5 s (default 1)
    # @raise [TimeoutError] when the email is not final before the deadline
    def wait: (Integer id, **untyped options) -> EmailDetail
  end
end
